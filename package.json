{
  "name": "tracegraph",
  "version": "0.0.1",
  "description": "The graph your agent actually follows — induce a behavioral spec from agent traces, then check, diff, and gate against it.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "tracegraph": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format esm --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:corpus": "npm run build && node scripts/corpus-integration.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayfarer-ai/tracegraph.git"
  },
  "keywords": [
    "agents",
    "agent-testing",
    "behavioral-spec",
    "graph",
    "mcp",
    "traces",
    "llm"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
